<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FModel.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#528BCC</Color>
            <Color x:Key="PrimaryDark">#3A6B99</Color>
            <Color x:Key="Accent">#98C379</Color>
            <Color x:Key="Background">#1E1E2E</Color>
            <Color x:Key="Surface">#252536</Color>
            <Color x:Key="SurfaceLight">#2D2D44</Color>
            <Color x:Key="Text">#DAE5F2</Color>
            <Color x:Key="TextSecondary">#BBBBBB</Color>
            <Color x:Key="Success">#98C379</Color>
            <Color x:Key="Error">#E06C75</Color>
            <Color x:Key="Warning">#E5C07B</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>