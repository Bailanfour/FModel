<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FModel.Maui.MainPage"
             BackgroundColor="{StaticResource Background}"
             Title="FModel Mobile">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16">
            <Label Text="FModel Mobile" TextColor="White" FontSize="24" FontAttributes="Bold" />
            <Label Text="Unreal Engine Asset Explorer" TextColor="White" FontSize="14" Opacity="0.8" />
        </StackLayout>

        <ScrollView Grid.Row="1" Padding="16">
            <StackLayout Spacing="16">
                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="📂 Select PAK File" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <Button 
                            Text="Browse PAK" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            CornerRadius="8"
                            Clicked="OnSelectPakClicked" />
                        <Label x:Name="PakInfoLabel" Text="No PAK file selected" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                    </StackLayout>
                </Frame>

                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="🔑 AES Key (Optional)" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <Entry 
                            x:Name="AesKeyEntry"
                            Placeholder="Enter 64-character AES key"
                            BackgroundColor="{StaticResource SurfaceLight}"
                            TextColor="{StaticResource Text}"
                            PlaceholderColor="{StaticResource TextSecondary}"
                            MaxLength="64"
                            IsPassword="False" />
                        <Label Text="Leave empty if PAK is not encrypted" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    </StackLayout>
                </Frame>

                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="📁 Output Directory" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="OutputPathLabel" Text="Exports will be saved to app data" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                    </StackLayout>
                </Frame>

                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16" IsVisible="{Binding IsUnpacking}">
                    <StackLayout Spacing="8">
                        <Label Text="⚡ Unpacking Progress" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <ProgressBar x:Name="ProgressBar" Progress="0" Color="{StaticResource Primary}" />
                        <Label x:Name="ProgressLabel" Text="Initializing..." TextColor="{StaticResource TextSecondary}" FontSize="14" />
                        <Label x:Name="ProgressPercentage" Text="0%" TextColor="{StaticResource Accent}" FontSize="16" FontAttributes="Bold" />
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="2" BackgroundColor="{StaticResource SurfaceLight}" Padding="12" Orientation="Horizontal" HorizontalOptions="Center">
            <Button 
                x:Name="LoadButton"
                Text="Load PAK" 
                BackgroundColor="{StaticResource Primary}" 
                TextColor="White" 
                CornerRadius="8" 
                WidthRequest="120"
                Clicked="OnLoadClicked" />
            <Button 
                x:Name="ExportButton"
                Text="Export All" 
                BackgroundColor="{StaticResource Accent}" 
                TextColor="White" 
                CornerRadius="8" 
                WidthRequest="120" 
                Margin="12,0"
                Clicked="OnExportClicked"
                IsEnabled="False" />
            <Button 
                x:Name="CancelButton"
                Text="Cancel" 
                BackgroundColor="{StaticResource Surface}" 
                TextColor="{StaticResource Text}" 
                CornerRadius="8" 
                WidthRequest="120"
                Clicked="OnCancelClicked"
                IsVisible="False" />
        </StackLayout>
    </Grid>
</ContentPage>