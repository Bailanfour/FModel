<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FModel.Maui.ViewModels"
             x:Class="FModel.Maui.MainPage"
             BackgroundColor="{StaticResource Background}"
             Title="FModel Mobile">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackLayout Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="16">
            <Label Text="FModel Mobile" TextColor="White" FontSize="24" FontAttributes="Bold" />
            <Label Text="Unreal Engine Asset Explorer" TextColor="White" FontSize="14" Opacity="0.8" />
        </StackLayout>

        <ScrollView Grid.Row="1" Padding="16">
            <StackLayout Spacing="16">
                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="📂 Archive Loading" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <Button 
                            Text="Select Archive" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            CornerRadius="8"
                            Clicked="OnSelectArchiveClicked" />
                        <Label x:Name="ArchiveInfoLabel" Text="No archive selected" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                    </StackLayout>
                </Frame>

                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="🎮 Game Archives" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <ListView 
                            x:Name="ArchiveListView"
                            BackgroundColor="Transparent"
                            SeparatorVisibility="None"
                            ItemTapped="OnArchiveTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid Padding="8" BackgroundColor="{StaticResource SurfaceLight}" Margin="0,4" CornerRadius="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="folder.png" WidthRequest="32" HeightRequest="32" Grid.Column="0" />
                                            <StackLayout Grid.Column="1">
                                                <Label Text="{Binding Name}" TextColor="{StaticResource Text}" FontSize="14" />
                                                <Label Text="{Binding FileCount} files" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                            </StackLayout>
                                            <Label Grid.Column="2" Text="{Binding Size}" TextColor="{StaticResource TextSecondary}" FontSize="12" HorizontalOptions="End" VerticalOptions="Center" />
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackLayout>
                </Frame>

                <Frame BackgroundColor="{StaticResource Surface}" CornerRadius="8" Padding="16">
                    <StackLayout Spacing="8">
                        <Label Text="⚙️ Settings" TextColor="{StaticResource Text}" FontSize="18" FontAttributes="Bold" />
                        <Switch 
                            x:Name="PreviewSwitch"
                            IsToggled="{Binding PreviewAssets}"
                            OnColor="{StaticResource Primary}" />
                        <Label Text="Preview Assets" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="2" BackgroundColor="{StaticResource SurfaceLight}" Padding="12" Orientation="Horizontal" HorizontalOptions="Center">
            <Button 
                Text="Load" 
                BackgroundColor="{StaticResource Primary}" 
                TextColor="White" 
                CornerRadius="8" 
                WidthRequest="120"
                Clicked="OnLoadClicked" />
            <Button 
                Text="Clear" 
                BackgroundColor="{StaticResource Surface}" 
                TextColor="{StaticResource Text}" 
                CornerRadius="8" 
                WidthRequest="120" 
                Margin="12,0"
                Clicked="OnClearClicked" />
        </StackLayout>
    </Grid>
</ContentPage>